# LLM Provider Configuration
LLM_PROVIDER=deepseek          # deepseek | claude | openai | gemini
DEEPSEEK_API_KEY=              # Default provider
ANTHROPIC_API_KEY=             # Optional: Claude
OPENAI_API_KEY=                # Optional: OpenAI
GOOGLE_AI_API_KEY=             # Optional: Gemini

# Supabase
# For cloud: use https://<project-id>.supabase.co
# For local dev: use http://127.0.0.1:54321
# For Docker local: use http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend
# For local dev: use http://localhost:8000
# For Docker: use http://host.docker.internal:8000
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
